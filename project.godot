;   param=value ; assign values to parameters

config_version=5

[application]

config/name="loan"
run/main_scene="uid://ht1x0mynbke1"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=140
boot_splash/bg_color=Color(0.36833754, 0.25108722, 0.4118105, 1)
boot_splash/image="uid://jyqqjmcdaikk"
config/icon="res://icon.svg"

[autoload]

BackgroundMusic="*uid://c0fcx5y54ma62"
AudioManager="*uid://bweu5ic4e0kfn"
TransitionManager="*uid://ciojogsxyo26y"

[display]

window/size/viewport_height=700
window/size/mode=3
window/stretch/mode="canvas_items"
